{
  "manifest_version": 3,
  "name": "Watermark Inspector",
  "version": "2.1.0",
  "description": "Extrai imagens e remove marcas d'água com IA local.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage",
    "unlimitedStorage",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Watermark Inspector"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "inpaint.html",
        "inpaint.js",
        "lib/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}